# Environment: development / production
ENVIRONMENT=production
PROJECT_NAME="MoneyHoney"

# Linux Server Ports & Hosts
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (via SSH tunnel or local engine)
# When using SSH tunnel from Linux to Laptop SSMS:
DATABASE_URL=mssql+pyodbc://localhost:1433/STOCK_DATA?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=no&UID=sa&PWD=YourPasswordHere

# Streamlit Frontend URL & API Gateway Base URL
API_GATEWAY_URL=http://localhost:80/api/v1
STREAMLIT_SERVER_PORT=8501
